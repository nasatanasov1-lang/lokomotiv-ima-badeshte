{
  "name": "lokomotiv-ima-badeshte",
  "compatibility_date": "2026-09-12",
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "VOICES_DB",
      "database_name": "lokomotiv-plovdiv",
      "database_id": "4528d038-6a25-43c5-bf81-6fcd3690e001"
    }
  ],
  "secrets_store_secrets": [
    {
      "binding": "ADMIN_PASSWORD",
      "store_id": "9821695a4bdd40e0988ea8d39f1728fb",
      "secret_name": "ADMIN_PASSWORD"
    }
  ],
  "ratelimits": [
    {
      "name": "VOICES_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ]
}
