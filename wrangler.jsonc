{
  "name": "lokomotiv-ima-badeshte",
  "compatibility_date": "2026-09-12",
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "VOICES_DB",
      "database_name": "lokomotiv-plovdiv",
      // TODO: сложи Database ID-то от Cloudflare Dashboard -> D1 -> lokomotiv-plovdiv
      "database_id": "4528d038-6a25-43c5-bf81-6fcd3690e001"
    }
  ]
}
